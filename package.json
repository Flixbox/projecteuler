{
  "name": "projecteuler",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "engines": {
    "bun": ">=1.3.2"
  },
  "scripts": {
    "format": "biome format --write .",
    "lint": "bunx npm-run-all --continue-on-error \"lint:*\"",
    "lint:common": "biome lint .",
    "lint:typecheck": "bunx tsc --noEmit",
    "lint:knip": "knip",
    "check": "biome check --write .",
    "postinstall": "touch tsconfig.json"
  },
  "devDependencies": {
    "@arthurrios/biome-config": "1.1.4",
    "@biomejs/biome": "2.3.10",
    "@types/bun": "latest",
    "knip": "5.75.1",
    "typescript": "5.9.3"
  }
}
